# ICELINE PRO — Environment Variables
# Copy to .env.local and fill in your values

# ==========================================
# Supabase (https://supabase.com)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# Telegram Bot Notifications
# 1. Create bot: @BotFather -> /newbot
# 2. Get chat ID: send msg to bot, open
#    https://api.telegram.org/bot{TOKEN}/getUpdates
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
TELEGRAM_CHAT_ID=-1001234567890

# ==========================================
# App URL
# ==========================================
NEXT_PUBLIC_APP_URL=https://iceline-pro.vercel.app

# ==========================================
# YuKassa Payment (https://yookassa.ru)
# ==========================================
# YUKASSA_SHOP_ID=your-shop-id
# YUKASSA_SECRET_KEY=your-secret-key

# ==========================================
# UniSender Newsletter (https://unisender.com)
# ==========================================
# UNISENDER_API_KEY=your-api-key
# UNISENDER_LIST_ID=your-list-id

# ==========================================
# Yandex Metrika
# ==========================================
# NEXT_PUBLIC_METRIKA_ID=12345678
